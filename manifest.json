{
    "manifest_version": 2,
    "name": "UManitoba RateMyProf Finder",
    "version": "1.5",
    "browser_specific_settings": {
      "gecko": {
        "id": "{e90be9af-3819-406e-ac27-35ed09a87ba4}",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        },
        "strict_min_version": "58.0"
      }
    },

    "description": "Integrates statistics from RateMyProfessors into UManitoba's Aurora Registration.",
    "permissions": ["activeTab", "webRequest", "https://aurora-registration.umanitoba.ca/StudentRegistrationSsb/ssb/courseSearch/courseSearch*", "https://aurora-registration.umanitoba.ca/StudentRegistrationSsb/ssb/classSearch/classSearch*", "https://aurora-registration.umanitoba.ca/StudentRegistrationSsb/ssb/classRegistration/classRegistration*", "https://www.ratemyprofessors.com/*"],
    "icons": {
      "48": "icons/rmp-48.png"
    },

    "background": {
    "scripts": ["./scr/searchrmp.js"]
  },
    "content_scripts": [
      {
        "matches": ["https://aurora-registration.umanitoba.ca/StudentRegistrationSsb/ssb/courseSearch/courseSearch*", "https://aurora-registration.umanitoba.ca/StudentRegistrationSsb/ssb/classSearch/classSearch*", "https://aurora-registration.umanitoba.ca/StudentRegistrationSsb/ssb/classRegistration/classRegistration*"],
        "js": ["./scr/displaypopup.js"]
      }
    ]
  }
